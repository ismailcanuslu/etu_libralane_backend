# Yerel geliştirme (macOS / Linux)
DB_PATH=./data/jobs.db
WORKSPACE_ROOT=./workspace
JOBS_HOST_DIR=./data/jobs

# SkyWater 130 PDK — host'ta varsa tam yolu verin; boş bırakırsanız runner imajı içindeki /openlane/pdk kullanılır
OPENLANE_PDK_HOST_PATH=
OPENLANE_PDK_MOUNT_PATH=/openlane/pdk

RUNNER_IMAGE_OPENLANE=efabless/openlane:ci2504-dev-amd64
ENABLE_OPENLANE_TOOLS=true
